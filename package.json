{
  "name": "x-insight-cache",
  "version": "0.1.0",
  "description": "Self-hosted, API-key-gated community cache server for the x-account-insight browser extension. Not affiliated with x-account-location-device or its author.",
  "type": "module",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node scripts/chart-test.mjs && node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true
  }
}
