# Copy this to .env and fill in a real value before running docker compose up.
# Generate one with: node -e "console.log(require('crypto').randomUUID())"
API_KEY=

# How long an entry survives without being re-contributed, in days.
RETENTION_DAYS=60

# Optional read-only dashboard at /admin/. Set both to enable login.
# Use a strong password different from API_KEY.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Keep true behind HTTPS (including Traefik). Set false ONLY for local HTTP.
ADMIN_SECURE_COOKIE=true
